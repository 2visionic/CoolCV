{
  "name": "cool-cv-react-ts-php",
  "version": "2.1.0",
  "description": "Profesionální strukturované CV & Portfolio: React 18 + TypeScript (.tsx) Frontend & Backoffice + Tailwind CSS + PHP 8 REST API (JWT HS256 & AES-256-CBC šifrování)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/coolpublisher-build.mjs",
    "build:tsx": "node scripts/compile-jsx.mjs",
    "build:publish": "node scripts/coolpublisher-build.mjs",
    "test": "node scripts/dev.mjs --check",
    "db:seed": "node scripts/seed-json.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "html2pdf.js": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
